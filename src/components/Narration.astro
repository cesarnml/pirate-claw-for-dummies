---
import fs from 'node:fs';
import path from 'node:path';

interface Props { next?: string }
const { next = '' } = Astro.props;
const key = Astro.url.pathname.replace(/^\/|\/$/g, '') || 'index';
const sidecar = path.join(process.cwd(), 'public/audio', `${key}.json`);
const hasAudio = fs.existsSync(sidecar);
let duration = 0;
if (hasAudio) {
  try { duration = JSON.parse(fs.readFileSync(sidecar, 'utf8')).duration ?? 0; } catch { /* intentionally silent */ }
}
---

{hasAudio && (
  <div class="narration not-content" data-narration data-key={key} data-next={next}>
    <button class="narration-play" type="button" aria-label="Play narration" title="Play or pause narration (Option+P)">
      <span class="play-glyph">▶</span><span class="pause-glyph">Ⅱ</span>
    </button>
    <div class="narration-body">
      <button class="narration-track" type="button" role="slider" aria-label="Seek narration" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span /></button>
      <div class="narration-meta"><span class="narration-time">0:00 / {Math.ceil(duration / 60)} min</span><span>
        <button class="narration-rate" type="button" aria-label="Change playback speed">1×</button>
        <button class="narration-reset" type="button" aria-label="Restart narration">↺</button>
        <label><input class="narration-chain" type="checkbox" checked /> Continue</label>
      </span></div>
    </div>
    <audio preload="none" src={`/audio/${key}.mp3`} />
    <div class="narration-mini" aria-label="Sticky narration controls">
      <button class="mini-play" type="button" aria-label="Play narration">▶</button>
      <button class="mini-track" type="button" role="slider" aria-label="Seek narration" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span /></button>
      <span class="mini-time">0:00</span>
      <button class="mini-rate" type="button" aria-label="Change playback speed">1×</button>
    </div>
  </div>
)}

<style>
  .narration { display:flex; align-items:center; gap:.8rem; margin:1rem 0 1.8rem; padding:.75rem .9rem; border:1px solid var(--sl-color-hairline); border-radius:.8rem; background:color-mix(in srgb, var(--sl-color-bg) 88%, var(--pc-teal)); }
  .narration-play,.mini-play { display:grid; place-items:center; flex:none; border:0; width:2.55rem; height:2.55rem; border-radius:50%; background:var(--pc-teal); color:#06211e; font-weight:800; cursor:pointer; }
  .pause-glyph,.narration[data-playing] .play-glyph { display:none; }.narration[data-playing] .pause-glyph { display:inline; }
  .narration-body { flex:1; min-width:0; }.narration-track,.mini-track { display:block; width:100%; border:0; padding:.45rem 0; background:transparent; cursor:pointer; }
  .narration-track::before,.mini-track::before { display:block; height:.3rem; border-radius:99px; background:var(--sl-color-gray-5); content:''; }
  .narration-track span,.mini-track span { display:block; position:relative; top:.3rem; height:.3rem; width:0; border-radius:99px; background:var(--pc-teal); }
  .narration-meta { display:flex; justify-content:space-between; align-items:center; gap:.5rem; font-size:.76rem; color:var(--sl-color-gray-3); }.narration-meta button { border:0; background:transparent; color:var(--sl-color-text-accent); cursor:pointer; }.narration-meta label { margin-left:.55rem; }
  .narration-mini { display:none; position:fixed; z-index:30; top:var(--sl-nav-height); left:0; right:0; align-items:center; gap:.65rem; padding:.4rem 1rem; border-bottom:1px solid var(--sl-color-hairline); background:var(--sl-color-bg-nav); backdrop-filter:blur(14px); }.narration-mini[data-visible] { display:flex; }.mini-play { width:1.8rem; height:1.8rem; font-size:.72rem; }.mini-track { flex:1; min-width:3rem; }.mini-time { font-size:.76rem; color:var(--sl-color-gray-3); }.mini-rate { border:0; background:transparent; color:var(--sl-color-text-accent); cursor:pointer; }
  @media (max-width: 38rem) { .narration-meta label { display:none; }.narration-time { white-space:nowrap; } }
</style>

<style is:global>
  .sl-markdown-content [data-tts] { border-radius:.2rem; transition:background .18s ease; }
  .sl-markdown-content [data-tts].tts-active { background:color-mix(in srgb, var(--pc-teal) 20%, transparent); }
  .tts-seekable .sl-markdown-content [data-tts]:hover { cursor:pointer; background:color-mix(in srgb, var(--pc-teal) 11%, transparent); }
  @media (prefers-reduced-motion: reduce) { .sl-markdown-content [data-tts] { transition:none; } }
</style>

<script>
  type Timing = { duration: number; sentences: Array<{ i: number; start: number; end: number }> };
  const rates = [0.9, 1, 1.15, 1.3, 1.5, 1.75];

  function mount(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const key = root.dataset.key!;
    const audio = root.querySelector('audio')!;
    const play = root.querySelector<HTMLButtonElement>('.narration-play')!;
    const track = root.querySelector<HTMLButtonElement>('.narration-track')!;
    const fill = track.querySelector('span')!;
    const time = root.querySelector<HTMLElement>('.narration-time')!;
    const rate = root.querySelector<HTMLButtonElement>('.narration-rate')!;
    const reset = root.querySelector<HTMLButtonElement>('.narration-reset')!;
    const chain = root.querySelector<HTMLInputElement>('.narration-chain')!;
    const mini = root.querySelector<HTMLElement>('.narration-mini')!;
    document.querySelectorAll('body > .narration-mini').forEach((node) => node.remove());
    document.body.appendChild(mini);
    const miniPlay = mini.querySelector<HTMLButtonElement>('.mini-play')!;
    const miniTrack = mini.querySelector<HTMLButtonElement>('.mini-track')!;
    const miniFill = miniTrack.querySelector('span')!;
    const miniTime = mini.querySelector<HTMLElement>('.mini-time')!;
    const miniRate = mini.querySelector<HTMLButtonElement>('.mini-rate')!;
    const positionKey = `pc-tts:${key}`;
    let timing: Timing | null = null;
    let active = -1;
    let raf = 0;
    const spans = new Map<number, HTMLElement>();

    const setRate = (value: number) => { audio.playbackRate = value; rate.textContent = `${value}×`; miniRate.textContent = `${value}×`; localStorage.setItem('pc-tts-rate', String(value)); };
    setRate(Number(localStorage.getItem('pc-tts-rate') ?? '1'));
    chain.checked = localStorage.getItem('pc-tts-chain') !== '0';
    const clock = (seconds: number) => `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;
    const loadTiming = async () => {
      if (!timing) {
        const response = await fetch(`/audio/${key}.json`);
        if (!response.ok) throw new Error('narration timing unavailable');
        timing = await response.json();
        document.querySelectorAll<HTMLElement>('[data-tts]').forEach((span) => spans.set(Number(span.dataset.tts), span));
        document.body.classList.add('tts-seekable');
      }
      return timing;
    };
    const highlight = (seconds: number) => {
      if (!timing) return;
      let low = 0; let high = timing.sentences.length - 1;
      while (low <= high) {
        const middle = Math.floor((low + high) / 2);
        if (timing.sentences[middle].end < seconds) low = middle + 1;
        else high = middle - 1;
      }
      const index = Math.min(timing.sentences.length - 1, Math.max(0, low));
      if (index === active) return;
      const previous = timing.sentences[active];
      if (previous) spans.get(previous.i)?.classList.remove('tts-active');
      active = index;
      const span = spans.get(timing.sentences[index]?.i);
      span?.classList.add('tts-active');
      if (span) {
        const box = span.getBoundingClientRect();
        if (box.top < 80 || box.bottom > window.innerHeight - 80) {
          span.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        }
      }
    };
    const tick = () => { const percentNumber = (audio.currentTime / (audio.duration || 1)) * 100; const percent = `${percentNumber}%`; fill.style.width = percent; miniFill.style.width = percent; track.setAttribute('aria-valuenow', String(Math.round(percentNumber))); miniTrack.setAttribute('aria-valuenow', String(Math.round(percentNumber))); time.textContent = `${clock(audio.currentTime)} / ${Math.ceil((audio.duration || timing?.duration || 0) / 60)} min`; miniTime.textContent = clock(audio.currentTime); highlight(audio.currentTime); raf = requestAnimationFrame(tick); };
    const start = async () => { await loadTiming(); if (audio.readyState < 1) { audio.load(); await new Promise<void>((resolve) => audio.addEventListener('loadedmetadata', () => resolve(), { once:true })); } const saved = Number(localStorage.getItem(positionKey) ?? 0); if (saved > 1 && audio.currentTime < 1) audio.currentTime = saved; await audio.play(); };
    const seek = (event: PointerEvent, target: HTMLElement) => { const bounds = target.getBoundingClientRect(); audio.currentTime = Math.max(0, Math.min(1, (event.clientX - bounds.left) / bounds.width)) * (audio.duration || timing?.duration || 0); };
    play.addEventListener('click', () => audio.paused ? start().catch(() => {}) : audio.pause()); miniPlay.addEventListener('click', () => play.click());
    track.addEventListener('pointerdown', (event) => seek(event, track)); miniTrack.addEventListener('pointerdown', (event) => seek(event, miniTrack));
    const seekByKey = (event: KeyboardEvent) => { if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return; event.preventDefault(); const duration = audio.duration || timing?.duration || 0; if (event.key === 'Home') audio.currentTime = 0; else if (event.key === 'End') audio.currentTime = duration; else audio.currentTime = Math.max(0, Math.min(duration, audio.currentTime + (event.key === 'ArrowRight' ? 10 : -10))); };
    track.addEventListener('keydown', seekByKey); miniTrack.addEventListener('keydown', seekByKey);
    rate.addEventListener('click', () => setRate(rates[(rates.indexOf(audio.playbackRate) + 1) % rates.length]!)); miniRate.addEventListener('click', () => rate.click());
    reset.addEventListener('click', () => { audio.pause(); audio.currentTime = 0; localStorage.removeItem(positionKey); });
    chain.addEventListener('change', () => localStorage.setItem('pc-tts-chain', chain.checked ? '1' : '0'));
    audio.addEventListener('play', () => { root.dataset.playing = ''; cancelAnimationFrame(raf); raf = requestAnimationFrame(tick); });
    audio.addEventListener('pause', () => { delete root.dataset.playing; cancelAnimationFrame(raf); localStorage.setItem(positionKey, String(audio.currentTime)); });
    audio.addEventListener('ended', () => { localStorage.removeItem(positionKey); if (chain.checked && root.dataset.next) { sessionStorage.setItem('pc-tts-autoplay', '1'); location.href = root.dataset.next; } });
    document.querySelector('.sl-markdown-content')?.addEventListener('click', (event) => { const span = (event.target as HTMLElement).closest<HTMLElement>('[data-tts]'); if (!span || !timing || window.getSelection()?.toString()) return; const item = timing.sentences.find((entry) => String(entry.i) === span.dataset.tts); if (!item) return; audio.currentTime = item.start; if (audio.paused) audio.play().catch(() => {}); });
    const updateSticky = () => { if (!root.isConnected) return; const header = document.querySelector('header.header')?.getBoundingClientRect().height ?? 0; mini.toggleAttribute('data-visible', root.getBoundingClientRect().bottom < header); };
    addEventListener('scroll', updateSticky, { passive:true }); addEventListener('resize', updateSticky); updateSticky();
    if (sessionStorage.getItem('pc-tts-autoplay') === '1') { sessionStorage.removeItem('pc-tts-autoplay'); start().catch(() => {}); }
  }
  const run = () => document.querySelector<HTMLElement>('[data-narration]') && mount(document.querySelector<HTMLElement>('[data-narration]')!);
  run(); document.addEventListener('astro:page-load', run);
  document.addEventListener('keydown', (event) => { if (event.code !== 'KeyP' || !event.altKey) return; if ((event.target as HTMLElement | null)?.closest('input, textarea, [contenteditable]')) return; const control = document.querySelector<HTMLButtonElement>('[data-narration] .narration-play'); if (control) { event.preventDefault(); control.click(); } });
</script>
